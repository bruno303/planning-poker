CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
LOG_LEVEL=INFO
TRACE_ENABLED=true
TRACE_OTLP_ENDPOINT=localhost:4317
ENVIRONMENT=local
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

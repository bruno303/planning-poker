COMPOSE_PROJECT_NAME=planning-poker
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
# Optional external Loki example; local Compose does not start Loki.
LOKI_HOST_PORT=3100

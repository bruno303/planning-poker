NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080
# Optional external Loki endpoint.
LOKI_URL=http://localhost:3100
LOG_ENV=local
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_UNVOTED_NOTIFICATION_DELAY_MS=4000
NEXT_PUBLIC_UNVOTED_NOTIFICATION_REPEAT_INTERVAL_MS=10000
NEXT_PUBLIC_UNVOTED_NOTIFICATION_MAX_REPEATS=3
NEXT_PUBLIC_UNVOTED_NOTIFICATION_SOUND_ENABLED=true
NEXT_PUBLIC_UNVOTED_NOTIFICATION_SOUND_VOLUME=0.12
